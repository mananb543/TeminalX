# ==========================================
# TERMINALX - Environment Variables Configuration
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Database Configuration (MongoDB & Mongoose)
MONGODB_URI=
MONGODB_DB_NAME=terminalx

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Market Data API Providers (Optional in Demo Mode)
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com

# Initial Paper Trading Balance (Default: ₹10,00,000 / 10 Lakhs INR)
INITIAL_VIRTUAL_BALANCE=1000000

# Quantitative Risk Analysis Parameters (Default: 6.0% annualized risk-free rate assumption)
PORTFOLIO_RISK_FREE_RATE=0.06

# AI Financial Intelligence Engine (Gemini / Deterministic Fallback)
# Provider options: 'gemini' | 'deterministic'
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
GEMINI_API_KEY=
# Financial News & Event Intelligence Engine
# Provider options: 'demo' | 'real'
NEWS_PROVIDER=demo
NEWS_API_KEY=
NEWS_BASE_URL=https://api.twelvedata.com
